@using Microsoft.AspNetCore.Http

@{
    var userId = Context.Session.GetInt32("UserId");
    var displayName = Context.Session.GetString("DisplayName");
    var role = Context.Session.GetString("Role");
}

<ul class="navbar-nav align-items-sm-center">
    @if (userId.HasValue)
    {
        <li class="nav-item">
            <span class="nav-link text-dark">
                Hello, @displayName
                <span class="badge bg-primary">@role</span>
            </span>
        </li>

        <li class="nav-item">
            <form asp-controller="Auth"
                  asp-action="Logout"
                  method="post"
                  class="mb-0">
                <button type="submit"
                        class="btn btn-outline-danger btn-sm">
                    Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-controller="Auth"
               asp-action="Register">
                Register
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-controller="Auth"
               asp-action="Login">
                Login
            </a>
        </li>
    }
</ul>