@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<div class="alert alert-warning">
    <h1 class="h4">We could not complete that request</h1>
    <p>Please try again shortly. If you were saving a change, check whether it was saved before submitting it again.</p>
    @if (Model.ShowRequestId)
    {
        <p>Reference: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">Back to home</a>
</div>
