<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header>
        <nav class="navbar navbar-expand-xl navbar-light bg-white border-bottom" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Race<span>Day</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#main-navigation" aria-controls="main-navigation"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-navigation">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    </ul>
                    <partial name="_AccountMenu" />
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" class="container py-4 flex-grow-1" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="site-footer border-top py-3">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.UtcNow.Year RaceDay · Run. Walk. Cycle.</span>
            <a asp-controller="Home" asp-action="Privacy">About your data</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
