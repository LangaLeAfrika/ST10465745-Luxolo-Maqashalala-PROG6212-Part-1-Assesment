@model RaceDay.Mvc.ViewModels.RegisterVm

@{
    ViewData["Title"] = "Create account";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1>Create your RaceDay account</h1>
        <p class="text-muted">
            Join an event or organise your own.
        </p>

        <form asp-controller="Auth"
              asp-action="Register"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName"
                       class="form-control"
                       autocomplete="given-name" />
                <span asp-validation-for="FirstName"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName"
                       class="form-control"
                       autocomplete="family-name" />
                <span asp-validation-for="LastName"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email"
                       class="form-control"
                       autocomplete="email" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password"
                       class="form-control"
                       autocomplete="new-password" />
                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword"
                       class="form-label"></label>
                <input asp-for="ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RoleId" class="form-label"></label>
                <select asp-for="RoleId" class="form-select">
                    <option value="2">Participant</option>
                    <option value="1">Organiser</option>
                </select>
                <span asp-validation-for="RoleId"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Create account
            </button>

            <a asp-action="Login" class="btn btn-link">
                Already registered? Log in
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}