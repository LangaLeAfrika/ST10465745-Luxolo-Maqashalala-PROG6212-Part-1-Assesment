@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Home";
    var role = Context.Session.GetString("Role");
    var signedIn = Context.Session.GetInt32("UserId").HasValue;
}
<section class="race-hero mb-4">
    <p class="eyebrow">South African community events</p>
    <h1 class="display-4">Your next starting line.</h1>
    <p class="lead">Run, walk or cycle. Find your event, enter your category and follow your results.</p>
    <div class="d-flex flex-wrap gap-2 mt-4">
        @if (signedIn && role == "Organiser")
        {
            <a class="btn btn-light" asp-controller="Organiser" asp-action="Index">Open organiser dashboard</a>
        }
        else if (signedIn && role == "Participant")
        {
            <a class="btn btn-light" asp-controller="Participant" asp-action="Index">Browse events</a>
            <a class="btn btn-outline-light" asp-controller="Participant" asp-action="MyEvents">My entries</a>
        }
        else
        {
            <a class="btn btn-light" asp-controller="Auth" asp-action="Register">Create an account</a>
            <a class="btn btn-outline-light" asp-controller="Auth" asp-action="Login">Log in</a>
        }
    </div>
</section>
<div class="row g-3">
    <div class="col-md-4"><section class="card h-100"><div class="card-body"><h2 class="h4">Find your event</h2><p>Explore running, walking and cycling events by name, type and location.</p></div></section></div>
    <div class="col-md-4"><section class="card h-100"><div class="card-body"><h2 class="h4">Make your entry</h2><p>Choose a category and keep your entries together in My Events.</p></div></section></div>
    <div class="col-md-4"><section class="card h-100"><div class="card-body"><h2 class="h4">See your results</h2><p>View finish times and positions once your organiser records them.</p></div></section></div>
</div>
